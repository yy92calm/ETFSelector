<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ETF量化选择系统</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.5.0/echarts.min.js"></script>
</head>
<body>

<!-- 导航栏 -->
<nav class="navbar">
    <h1>ETF量化选择系统</h1>
    <div class="nav-links">
        <a href="#" class="active" data-tab="market">行情看板</a>
        <a href="#" data-tab="strategy">策略管理</a>
        <a href="#" data-tab="backtest">策略回测</a>
        <a href="#" data-tab="portfolio">实盘模拟</a>
    </div>
</nav>

<div class="container">

    <!-- ====== 行情看板 ====== -->
    <div id="tab-market" class="tab-content active">
        <div class="toolbar">
            <button class="btn btn-primary" onclick="syncETFList()">同步ETF列表</button>
            <button class="btn btn-success" onclick="updateTodayQuotes()">更新今日行情</button>
            <button class="btn btn-warning" onclick="showUpdateRangeModal()">更新区间行情</button>
            <span id="market-count" style="color:var(--text-secondary);font-size:13px;"></span>
        </div>
        
        <!-- 市场分类标签 -->
        <div class="market-tabs">
            <button class="market-tab active" data-market="all">全部</button>
            <button class="market-tab" data-market="sh">上交所</button>
            <button class="market-tab" data-market="sz">深交所</button>
            <button class="market-tab" data-market="cy">创业板</button>
            <button class="market-tab" data-market="kc">科创板</button>
            <button class="market-tab" data-market="hot">热门ETF</button>
        </div>

        <!-- 行情统计 -->
        <div class="stats-mini" id="market-stats" style="display:none;">
            <div class="stat-item">
                <span class="stat-label">总市值</span>
                <span class="stat-value" id="total-market-value">-</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">上涨</span>
                <span class="stat-value text-success" id="up-count">-</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">下跌</span>
                <span class="stat-value text-danger" id="down-count">-</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">平盘</span>
                <span class="stat-value" id="flat-count">-</span>
            </div>
        </div>

        <div class="card">
            <div class="card-title" id="market-title">全市场ETF行情</div>
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr>
                        <th class="sortable" data-sort="code" onclick="sortTable('code')">代码 <span class="sort-icon">↕</span></th>
                        <th>名称</th>
                        <th class="text-right sortable" data-sort="net_value" onclick="sortTable('net_value')">最新净值 <span class="sort-icon">↕</span></th>
                        <th class="text-right sortable" data-sort="net_value_change_pct" onclick="sortTable('net_value_change_pct')">净值增长率 <span class="sort-icon">↕</span></th>
                        <th>净值日期</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody id="market-table"></tbody>
                </table>
            </div>
            <div id="market-empty" class="empty-state" style="display:none;">
                <div class="icon">📊</div>
                <p>暂无行情数据，请先"同步ETF列表"然后"更新今日行情"</p>
            </div>
            
            <!-- 分页控件 -->
            <div class="pagination" id="market-pagination" style="display:none;">
                <div class="page-size-selector">
                    <label>每页显示：</label>
                    <select id="page-size" onchange="changePageSize()">
                        <option value="20">20条</option>
                        <option value="50" selected>50条</option>
                        <option value="100">100条</option>
                    </select>
                </div>
                <button class="btn btn-outline btn-sm" onclick="changePage(-1)">上一页</button>
                <span class="page-info">第 <span id="current-page">1</span> 页，共 <span id="total-pages">1</span> 页</span>
                <button class="btn btn-outline btn-sm" onclick="changePage(1)">下一页</button>
            </div>
        </div>
    </div>

    <!-- ====== 策略管理 ====== -->
    <div id="tab-strategy" class="tab-content">
        <div class="toolbar">
            <button class="btn btn-primary" onclick="showCreateStrategyModal()">+ 创建模板策略</button>
            <button class="btn btn-success" onclick="showAIStrategyModal()">AI 生成策略</button>
        </div>
        <div class="card">
            <div class="card-title">我的策略</div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>名称</th>
                            <th>类型</th>
                            <th>ETF</th>
                            <th>初始资金</th>
                            <th>状态</th>
                            <th>创建时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody id="strategy-table"></tbody>
                </table>
            </div>
            <div id="strategy-empty" class="empty-state" style="display:none;">
                <div class="icon">🧠</div>
                <p>暂无策略，点击上方按钮创建</p>
            </div>
        </div>
    </div>

    <!-- ====== 策略回测 ====== -->
    <div id="tab-backtest" class="tab-content">
        <div class="card">
            <div class="card-title">回测配置</div>
            <div class="form-row">
                <div class="form-group">
                    <label>选择策略</label>
                    <select id="bt-strategy"></select>
                </div>
                <div class="form-group">
                    <label>开始日期</label>
                    <input type="date" id="bt-start" value="2024-01-01">
                </div>
                <div class="form-group">
                    <label>结束日期</label>
                    <input type="date" id="bt-end">
                </div>
                <div class="form-group">
                    <label>初始资金</label>
                    <input type="number" id="bt-capital" value="100000">
                </div>
            </div>
            <button class="btn btn-primary" onclick="runBacktest()" id="bt-run-btn">开始回测</button>
        </div>

        <div id="bt-result" style="display:none;">
            <div class="stats-grid" id="bt-stats"></div>
            <div class="card">
                <div class="card-title">收益曲线</div>
                <div id="bt-chart" style="height:400px;"></div>
            </div>
            <div class="card">
                <div class="card-title">交易记录</div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>日期</th><th>ETF</th><th>方向</th><th class="text-right">价格</th><th class="text-right">数量</th><th class="text-right">金额</th><th>原因</th></tr>
                        </thead>
                        <tbody id="bt-trades"></tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
                    <span>每日策略执行详情</span>
                    <button class="btn btn-outline btn-sm" onclick="toggleDailyDetails()">展开/收起</button>
                </div>
                <div id="bt-daily-details" style="display:none;">
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>日期</th>
                                    <th>ETF</th>
                                    <th>策略信号</th>
                                    <th>执行动作</th>
                                    <th>持仓</th>
                                    <th>现金</th>
                                    <th>总资产</th>
                                </tr>
                            </thead>
                            <tbody id="bt-daily-tbody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ====== 实盘模拟 ====== -->
    <div id="tab-portfolio" class="tab-content">
        <div class="form-row" style="margin-bottom:16px;">
            <div class="form-group">
                <label>选择策略</label>
                <select id="pf-strategy" onchange="loadPortfolio()"></select>
            </div>
        </div>
        <div id="pf-content" style="display:none;">
            <div class="toolbar">
                <button class="btn btn-warning" onclick="catchUpStrategy()">补跑策略</button>
                <span id="pf-info" style="font-size:13px;color:var(--text-secondary);"></span>
            </div>
            <div class="stats-grid" id="pf-stats"></div>
            <div class="card">
                <div class="card-title">资产曲线</div>
                <div id="pf-chart" style="height:360px;"></div>
            </div>
            <div class="card">
                <div class="card-title">当前持仓</div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>ETF代码</th><th class="text-right">数量</th><th class="text-right">均价</th><th class="text-right">现价</th><th class="text-right">市值</th></tr></thead>
                        <tbody id="pf-holdings"></tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-title">交易记录</div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>日期</th><th>ETF</th><th>方向</th><th class="text-right">价格</th><th class="text-right">数量</th><th class="text-right">金额</th><th>原因</th></tr></thead>
                        <tbody id="pf-trades"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- 创建资产配置策略 Modal -->
<div class="modal-overlay" id="modal-create-strategy">
    <div class="modal" style="max-width:600px;">
        <div class="modal-title">创建资产配置策略</div>
        
        <div class="form-group">
            <label>策略名称</label>
            <input type="text" id="cs-name" placeholder="如: 科技股配置组合">
        </div>
        
        <div class="form-group">
            <label>ETF配置（动态添加ETF和占比）</label>
            <div id="etf-allocation-list" style="margin-bottom:12px;"></div>
            <div class="etf-search-container" style="position:relative;">
                <input type="text" id="cs-etf-search" placeholder="输入ETF代码或名称搜索..." autocomplete="off" style="width:100%;">
                <div class="etf-search-results" id="cs-etf-results"></div>
            </div>
            <div style="margin-top:8px;color:var(--text-secondary);font-size:13px;">
                <span id="allocation-total">当前占比总和: 0%</span>
                <span id="allocation-warning" style="color:var(--danger);margin-left:12px;"></span>
            </div>
        </div>
        
        <div class="form-group">
            <label>再平衡设置</label>
            <select id="cs-rebalance">
                <option value="none">不需要再平衡</option>
                <option value="monthly">每月再平衡</option>
                <option value="quarterly" selected>每季度再平衡</option>
                <option value="yearly">每年再平衡</option>
            </select>
            <div style="margin-top:8px;font-size:13px;color:var(--text-secondary);">
                当实际占比偏离目标占比超过 <input type="number" id="cs-threshold" value="5" min="1" max="20" style="width:60px;"> % 时触发再平衡
            </div>
        </div>
        
        <div class="form-group">
            <label>初始资金</label>
            <input type="number" id="cs-capital" value="100000" min="10000">
        </div>
        
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-create-strategy')">取消</button>
            <button class="btn btn-primary" onclick="submitCreateStrategy()" id="cs-submit-btn">创建策略</button>
        </div>
    </div>
</div>

<!-- AI策略 Modal -->
<div class="modal-overlay" id="modal-ai-strategy">
    <div class="modal">
        <div class="modal-title">AI 生成策略</div>
        <div class="form-group">
            <label>策略描述（用自然语言描述你的交易逻辑）</label>
            <textarea id="ai-desc" rows="4" placeholder="例如：当5日均线上穿20日均线时买入，下穿时卖出；同时RSI低于30时加仓，高于70时减仓"></textarea>
        </div>
        <div class="form-group">
            <label>选择ETF（支持代码或名称搜索）</label>
            <div class="etf-search-container">
                <input type="text" id="ai-etf-search" placeholder="输入ETF代码或名称搜索..." autocomplete="off">
                <div class="etf-search-results" id="ai-etf-results"></div>
            </div>
            <div class="etf-selected-list" id="ai-etf-selected"></div>
            <input type="hidden" id="ai-etfs">
        </div>
        <div class="form-group">
            <label>选择模型</label>
            <select id="ai-model">
                <option value="deepseek-v3">DeepSeek V3 (推荐)</option>
                <option value="glm-4.6">GLM-4.6</option>
                <option value="qwen3-235b-a22b-thinking-2507">Qwen3 235B Thinking</option>
                <option value="qwen3-max">Qwen3 Max</option>
                <option value="kimi-k2-0905">Kimi K2</option>
            </select>
        </div>
        <div class="form-group">
            <label>初始资金</label>
            <input type="number" id="ai-capital" value="100000">
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-ai-strategy')">取消</button>
            <button class="btn btn-success" onclick="submitAIStrategy()" id="ai-submit-btn">生成策略</button>
        </div>
    </div>
</div>

<!-- 编辑策略 Modal -->
<div class="modal-overlay" id="modal-edit-strategy">
    <div class="modal">
        <div class="modal-title">编辑策略</div>
        <input type="hidden" id="edit-strategy-id">
        <div class="form-group">
            <label>策略名称</label>
            <input type="text" id="edit-name" placeholder="策略名称">
        </div>
        <div class="form-group">
            <label>策略描述</label>
            <textarea id="edit-desc" rows="3" placeholder="策略描述"></textarea>
        </div>
        <div class="form-group">
            <label>选择ETF（支持代码或名称搜索）</label>
            <div class="etf-search-container">
                <input type="text" id="edit-etf-search" placeholder="输入ETF代码或名称搜索..." autocomplete="off">
                <div class="etf-search-results" id="edit-etf-results"></div>
            </div>
            <div class="etf-selected-list" id="edit-etf-selected"></div>
            <input type="hidden" id="edit-etfs">
        </div>
        <div class="form-group">
            <label>初始资金</label>
            <input type="number" id="edit-capital" value="100000">
        </div>
        <div class="form-group" id="edit-code-group" style="display:none;">
            <label>策略代码（仅AI策略可编辑）</label>
            <textarea id="edit-code" rows="10" placeholder="Python策略代码"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-edit-strategy')">取消</button>
            <button class="btn btn-primary" onclick="submitEditStrategy()" id="edit-submit-btn">保存</button>
        </div>
    </div>
</div>

<!-- 更新区间行情 Modal -->
<div class="modal-overlay" id="modal-update-range">
    <div class="modal">
        <div class="modal-title">更新指定区间行情</div>

<!-- ETF历史净值查看弹窗 -->
<div class="modal-overlay" id="modal-etf-history">
    <div class="modal" style="max-width:900px;">
        <div class="modal-header">
            <h2 id="history-etf-title">ETF净值历史走势</h2>
            <button class="modal-close" onclick="closeModal('modal-etf-history')">&times;</button>
        </div>
        
        <div class="modal-body">
            <!-- 净值走势图表 -->
            <div id="history-chart" style="width:100%;height:400px;margin-bottom:20px;"></div>
            
            <!-- 统计信息 -->
            <div style="margin-bottom:20px;">
                <strong id="history-count">-</strong>
            </div>
            
            <!-- 净值数据表格 -->
            <table class="data-table">
                <thead>
                    <tr>
                        <th>净值日期</th>
                        <th class="text-right">份额净值</th>
                        <th class="text-right">增长率</th>
                    </tr>
                </thead>
                <tbody id="history-table"></tbody>
            </table>
            
            <div id="history-empty" style="display:none;text-align:center;padding:40px;color:#999;">
                <p>暂无净值数据</p>
            </div>
        </div>
    </div>
</div>
<script src="/static/js/app.js"></script>
</body>
</html>
