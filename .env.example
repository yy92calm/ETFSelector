# 应用配置
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# 数据库
DATABASE_URL=sqlite:///./etf_selector.db

# OpenAI兼容API配置（用于AI策略生成）
# 使用阿里云DashScope API - 支持多种模型：qwen3.6-plus、kimi-k2.5、MiniMax-M2.5
LLM_API_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.6-plus

# 可选模型列表：
# - qwen3.6-plus（通义千问3.6增强版）
# - kimi-k2.5（Moonshot Kimi 2.5）
# - MiniMax-M2.5（MiniMax M2.5）

# 定时任务配置（每个工作日执行自驱动管道：净值更新→再平衡→舆情→AI分析）
SCHEDULER_HOUR=20
SCHEDULER_MINUTE=0